{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharos.local/schema/item.schema.json",
  "title": "Pharos Item Schema v0.4.0",
  "description": "파로스 앱·게임·AI 도구·영화·애니·만화 평가 1건. 정적 웹 프론트엔드가 서버 없이 하드 필터와 축별 가중치를 브라우저에서 계산할 수 있도록, 판정에 쓰이는 원자료(flags)와 티어별 필터 결과(hard_filters), 축 점수(axes), 근거 등급(evidence_grade), 출처(sources)를 모두 담는다. v0.3은 장르·용도별 비교군(arenas)을 더했고, v0.3.1은 maintenance_status(active·feature_complete·stale_unknown·abandoned)를 더해 '완결된 작품'과 '방치'를 구분한다. v0.4.0은 두 가지를 함께 담는다. ⑴ 4단 계층(도메인→대분류→비교군→항목) — 아이템에 domain(도메인 id)·category(대분류 id)를 명시하고 비교군·대분류·도메인 정의와 파일 위치를 data/catalog.json 으로 옮겼다(x-pharos.client.arenas 제거). ⑵ 확률형·P2W의 3단계 강제성 — hard_filters[gacha_random_items·p2w].impact(none·optional·core), item.monetization.free_play(무과금 충분성), strict_monetization 토글. 계산 계약은 최상위 x-pharos.client 참조. v31(2026-11-28)은 통합 미디어(media) 도메인을 영화(movie)·애니(anime)·만화(manga) 3개 도메인으로 나눴다 — 항목은 domain·category·arenas 로 새 계층을 가리키고, 판정 계산 계약은 바뀌지 않는다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "domain",
    "category",
    "platforms",
    "developer",
    "one_liner",
    "assessed_at",
    "maintenance_status",
    "arenas",
    "sources",
    "flags",
    "tiers",
    "axes",
    "verdict",
    "update_profile",
    "monetization",
    "data_quality"
  ],
  "properties": {
    "schema_version": {
      "const": "0.4.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "정적 사이트의 안정 식별자(슬러그). URL·파일명으로 그대로 쓴다."
    },
    "name": { "type": "string", "minLength": 1 },
    "icon": {
      "type": "string",
      "pattern": "^assets/icons/[a-z0-9][a-z0-9-]*\\.(png|jpg|jpeg|webp)$",
      "description": "카드·상세·비교 표에 쓰는 공식 아이콘 경로(웹 배포 루트 기준 상대경로, 선택). 각 스토어·개발사의 공식 아트워크를 scripts/fetch_icons.py 가 192×192 webp 로 정규화해 web/assets/icons/ 에 두고, 출처는 같은 폴더의 manifest.json 에 남긴다. 파일이 없으면 UI 는 이름 첫 글자 이니셜 배지로 대체한다."
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string" }
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "description": "최상위 도메인 id — data/catalog.json 의 domains[].id 를 참조한다(app·game·ai·movie·anime·manga, 추후 product). 목록·평균·순위는 도메인을 섞지 않는다. v0.4.2에서 ai(AI 도구)를 정식 등록했고, v31(2026-11-28)에서 통합 media 도메인을 movie(영화)·anime(애니)·manga(만화) 3개로 분리했다. 허용 목록은 x-pharos.client.domain_ids 이며 validate.py 가 catalog.json 과 대조한다."
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "description": "도메인 아래 대분류 id — data/catalog.json 의 categories[].id 를 참조한다(productivity·strategy-card·rpg 등). 아이템의 domain·category 는 소속 비교군의 domain·category 와 같아야 한다(validate.py 가 검사)."
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string" },
      "description": "통합 검색 보조 키워드(선택). 이름·별칭·개발사·장르·취향 태그·한 줄 정의로 잡히지 않는 검색어(옛 이름, 대체 대상 등)를 적는다."
    },
    "arenas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "description": "이 아이템이 속한 비교군(Arena) id 목록. 하나의 아이템이 여러 비교군에 들어갈 수 있다. 정의(도메인·대분류·데이터 파일)는 data/catalog.json 의 arenas 에 있고, 여기서는 id만 참조한다."
    },
    "arena_notes": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9][a-z0-9-]*$": { "type": "string", "minLength": 1 }
      },
      "description": "비교군별 핵심 비교 포인트 한 줄. 키는 arenas 에 포함된 id 여야 한다(validate.py 가 검사)."
    },
    "genres": {
      "type": "array",
      "items": { "type": "string" }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/platform" }
    },
    "developer": { "type": "string" },
    "publisher": { "type": ["string", "null"] },
    "release_date": { "type": ["string", "null"], "format": "date" },
    "one_liner": {
      "type": "string",
      "description": "마케팅 문구를 걷어낸 한 줄 정의."
    },
    "taste_tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "취향 결 매칭용 태그(local-first, minimal-ui, one-time-purchase, no-account 등)."
    },
    "assessed_at": { "type": "string", "format": "date" },
    "method": {
      "type": "string",
      "enum": ["desk_research", "hands_on", "mixed"],
      "description": "평가 방법. 데스크 리서치면 직접 플레이·설치 없이 공개 정보만 썼다는 뜻."
    },
    "review_tier": {
      "type": "string",
      "enum": ["verified", "auto_fact"],
      "default": "verified",
      "description": "이 기록의 발행 단계(2단계 발행 구조). verified=사람이 약관·과금·문장까지 검토한 항목(review_tier 가 없으면 기본값). auto_fact=공개 스토어·저장소 API 값만으로 만든 1차 판정 — 세부 약관·과금 함정·본질 검토는 순차 심층 검수에서 확정한다. UI 는 auto_fact 항목의 카드·상세에 '자동 수집' 배지를 붙이고 상세 상단에 1차 판정 안내를 띄운다(x-pharos.client.review_tiers)."
    },
    "maintenance_status": {
      "type": "string",
      "enum": ["active", "feature_complete", "stale_unknown", "abandoned"],
      "description": "제품이 지금 어떤 수명 단계인가. active=업데이트·운영이 이어짐, feature_complete=개발사가 완결을 선언(패키지 게임 등)해 업데이트 공백이 방치가 아님, stale_unknown=오래 멈췄고 완결·방치 여부를 확인하지 못함, abandoned=12개월 이상 중단 + 공약 미이행. feature_complete 만 stale_over_12m 필터에서 면제된다(x-pharos.client.stale_exemption)."
    },
    "maintenance_note": {
      "type": "string",
      "minLength": 1,
      "description": "maintenance_status 판단 근거 한 줄(선택이지만 feature_complete·abandoned 에는 사실상 필수)."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "flags": { "$ref": "#/$defs/flags" },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tier" }
    },
    "axes": { "$ref": "#/$defs/axes" },
    "verdict": { "$ref": "#/$defs/verdict" },
    "review_snapshot": { "$ref": "#/$defs/reviewSnapshot" },
    "update_profile": { "$ref": "#/$defs/updateProfile" },
    "monetization": { "$ref": "#/$defs/monetization" },
    "data_quality": { "$ref": "#/$defs/dataQuality" },
    "score_notes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_rating": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "ai_review": { "type": "string", "minLength": 1 }
      },
      "description": "v0.5.0 축 점수 산정 메모 — 사실(스토어 평점·표본 수·플래그)은 그대로 두고, 어떤 원칙(표본 규모 검증·비편향 객관 평가)이 점수를 움직였는지만 남긴다. 점수가 바뀐 축에는 반드시 채운다."
    },
    "encyclopedia": {
      "$ref": "#/$defs/encyclopedia",
      "description": "선택 사전 블록 — 평가·점수·티어와 별개로 작품·앱 자체를 설명하는 기본 정보. 개요(summary)·도메인별 핵심 제원(key_facts)·핵심 특징(highlights)·파로스 내 관련작 연결(related)·공식 참고 링크(official_links). 없으면 UI 가 기존 필드(one_liner·developer·release_date·genres·platforms·sources)로 기본 제원 폴백 뷰를 그린다. 기존 2,072종은 이 필드 없이도 그대로 유효하다(추가 전 선택 필드)."
    }
  },
  "$defs": {
    "grade": {
      "type": "string",
      "enum": ["A", "B", "C", "A/B", "A/C", "B/C", "unknown"],
      "description": "A=스토어·공식 직접 확인, B=언론·공식 발표 인용, C=3자 집계·개별 리뷰·커뮤니티."
    },
    "tri": {
      "type": "string",
      "enum": ["yes", "no", "unknown", "not_assessed"],
      "description": "3값 사실 + 미평가. unknown/not_assessed는 통과로 치지 않고 '주의'로 표시한다."
    },
    "signal": {
      "type": "string",
      "enum": ["green", "yellow", "red", "unknown"]
    },
    "verdictValue": {
      "type": "string",
      "enum": ["recommend", "conditional", "avoid"]
    },
    "platform": {
      "type": "string",
      "enum": ["steam", "android", "ios", "windows", "macos", "linux", "web", "console", "other", "cinema", "streaming", "tv", "print", "anilist", "letterboxd"]
    },
    "sourceIdList": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
      "description": "sources[].id 참조."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "url", "type", "grade", "accessed_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "title": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "type": {
          "type": "string",
          "enum": ["store", "official", "press", "aggregator", "community"]
        },
        "grade": { "$ref": "#/$defs/grade" },
        "accessed_at": { "type": "string", "format": "date" },
        "note": { "type": "string" }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "evidence_grade", "source_ids", "note"],
      "properties": {
        "value": { "$ref": "#/$defs/tri" },
        "evidence_grade": { "$ref": "#/$defs/grade" },
        "source_ids": { "$ref": "#/$defs/sourceIdList" },
        "verification": {
          "type": "string",
          "enum": ["direct", "reported_only", "inferred", "absent"],
          "description": "direct=직접 화면/문서 확인, reported_only=3자 서술 인용, inferred=정황 추론, absent=부재 근거(보도·불만 없음)."
        },
        "note": { "type": "string" }
      }
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "description": "하드 필터가 직접 읽는 원자료. 값은 yes/no/unknown/not_assessed이며 반드시 근거 등급을 동반한다.",
      "required": [
        "contains_ads",
        "gacha_random_items",
        "forced_ad_before_use",
        "bait_ad",
        "p2w",
        "iap_required_to_progress"
      ],
      "properties": {
        "contains_ads": { "$ref": "#/$defs/fact" },
        "gacha_random_items": { "$ref": "#/$defs/fact" },
        "forced_ad_before_use": { "$ref": "#/$defs/fact" },
        "bait_ad": { "$ref": "#/$defs/fact" },
        "p2w": { "$ref": "#/$defs/fact" },
        "iap_required_to_progress": { "$ref": "#/$defs/fact" },
        "subscription_required": { "$ref": "#/$defs/fact" },
        "account_required": { "$ref": "#/$defs/fact" },
        "stale_over_12m": { "$ref": "#/$defs/fact" },
        "compat_risk": {
          "$ref": "#/$defs/fact",
          "description": "보안·OS 호환성 이슈라는 별도 신호(선택). maintenance_status 'feature_complete' 로 stale_over_12m 을 면제받은 항목이라도 이 값이 yes 면 추천까지 가지 않고 '조건부 경고'로 내린다."
        },
        "data_collected": { "$ref": "#/$defs/fact" },
        "data_export": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "evidence_grade", "source_ids", "note"],
          "properties": {
            "value": {
              "type": "string",
              "enum": ["full", "partial", "none", "unknown"]
            },
            "evidence_grade": { "$ref": "#/$defs/grade" },
            "source_ids": { "$ref": "#/$defs/sourceIdList" },
            "note": { "type": "string" }
          }
        }
      }
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "enum": ["KRW", "USD", "EUR", "JPY", "GBP"] }
      }
    },
    "hardFilterResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_grade", "note"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pass", "fail", "unknown", "exempt"],
          "description": "pass=필터에 걸리지 않음, fail=걸림, unknown=근거 부족 → '주의', exempt=필터 대상이지만 면제 규칙 적용으로 거름 아님(현재 stale_over_12m + maintenance_status 'feature_complete' 에서만 허용). fail 이 항상 거름은 아니다 — impact 'optional' 은 strict_monetization 이 꺼져 있으면 '선택 과금' 배지로만 쓰인다(x-pharos.client.monetization_impact)."
        },
        "impact": {
          "type": "string",
          "enum": ["none", "optional", "core"],
          "description": "확률형·P2W 상품의 강제성 3단계(v0.4). none=상품 자체가 없음(status 'pass'), optional=상품은 있지만 인게임 재화·무과금으로 본편·핵심 콘텐츠를 충분히 즐길 수 있음(status 'fail' 이어도 기본 모드에서 거름 아님 → '선택 과금 · 무과금 가능' 배지), core=과금·확률형 뽑기 없이는 성장 벽에 막히거나 진행·경쟁이 실질적으로 불가능(status 'fail' → 즉시 거름). gacha_random_items·p2w 에만 쓰며, 값이 없으면 상태에서 추론한다(pass→none, fail→core). impact 가 optional 이면 item.monetization.free_play.value 가 'sufficient' 여야 한다(validate.py 검사)."
        },
        "evidence_grade": { "$ref": "#/$defs/grade" },
        "note": { "type": "string" },
        "source_ids": { "$ref": "#/$defs/sourceIdList" }
      }
    },
    "hardFilters": {
      "type": "object",
      "additionalProperties": false,
      "description": "티어별 하드 필터 판정. 9개 키를 모두 채운다(클라이언트 토글과 1:1).",
      "required": [
        "forced_ads",
        "gacha_random_items",
        "bait_ad",
        "p2w",
        "iap_required_to_progress",
        "stale_over_12m",
        "subscription_required",
        "account_required",
        "data_collection"
      ],
      "properties": {
        "forced_ads": { "$ref": "#/$defs/hardFilterResult" },
        "gacha_random_items": { "$ref": "#/$defs/hardFilterResult" },
        "bait_ad": { "$ref": "#/$defs/hardFilterResult" },
        "p2w": { "$ref": "#/$defs/hardFilterResult" },
        "iap_required_to_progress": { "$ref": "#/$defs/hardFilterResult" },
        "stale_over_12m": { "$ref": "#/$defs/hardFilterResult" },
        "subscription_required": { "$ref": "#/$defs/hardFilterResult" },
        "account_required": { "$ref": "#/$defs/hardFilterResult" },
        "data_collection": { "$ref": "#/$defs/hardFilterResult" }
      }
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier_id",
        "label",
        "kind",
        "price",
        "hard_filters",
        "verdict",
        "one_liner",
        "recommended_path"
      ],
      "properties": {
        "tier_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "label": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["free", "freemium", "demo", "one_time", "subscription", "license", "consumable"]
        },
        "price": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount", "currency", "period", "display"],
          "properties": {
            "amount": { "type": ["number", "null"], "minimum": 0 },
            "currency": { "type": "string", "enum": ["KRW", "USD", "EUR", "JPY", "GBP", "none"] },
            "period": { "type": "string", "enum": ["none", "month", "year", "one_time"] },
            "display": { "type": "string", "description": "사람이 읽는 가격 표기(플랫폼별 차이 포함)." }
          }
        },
        "limits": {
          "type": "array",
          "items": { "type": "string" },
          "description": "무료 한도·제약(노트 수, 기기 수, 저장량 등)."
        },
        "hard_filters": { "$ref": "#/$defs/hardFilters" },
        "axis_overrides": {
          "type": "object",
          "additionalProperties": false,
          "description": "티어가 실질적으로 다른 경험을 줄 때만 축 점수·신호를 덮어쓴다. 반드시 사유(note)를 적는다.",
          "properties": {
            "user_rating": { "$ref": "#/$defs/axisOverride" },
            "objective": { "$ref": "#/$defs/axisOverride" },
            "ai_review": { "$ref": "#/$defs/axisOverride" },
            "personal_fit": { "$ref": "#/$defs/axisOverride" }
          }
        },
        "verdict": { "$ref": "#/$defs/verdictValue" },
        "one_liner": { "type": "string" },
        "recommended_path": {
          "type": "boolean",
          "description": "이 티어가 '최소 비용 추천 경로'인지. 티어당 1개만 true."
        },
        "notes": { "type": "string" }
      }
    },
    "axisOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "signal", "note"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "signal": { "$ref": "#/$defs/signal" },
        "note": { "type": "string" }
      }
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "signal", "evidence_grade", "confidence", "summary"],
      "properties": {
        "score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100,
          "description": "0~100 정규화 점수. 근거가 없으면 null(가중치 계산에서 제외)."
        },
        "signal": { "$ref": "#/$defs/signal" },
        "signal_basis": {
          "type": "string",
          "enum": ["score", "review_override"],
          "description": "score=임계값 자동 산출, review_override=사람 검토로 덮어씀(사유 필수)."
        },
        "evidence_grade": { "$ref": "#/$defs/grade" },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "summary": { "type": "string" },
        "source_ids": { "$ref": "#/$defs/sourceIdList" },
        "profile_id": {
          "type": "string",
          "description": "personal_fit 축이 특정 프로필 기준일 때(예: P1). 프로필 전용 축임을 표시."
        },
        "override_reason": {
          "type": "string",
          "description": "signal_basis=review_override일 때 임계값과 다르게 판단한 이유."
        },
        "scale_adjustment": {
          "type": "object",
          "description": "v0.6.0 표본 규모 보정 기록 — user_rating 축에만 쓴다. base_score + applied = score, final_score = score 를 만족해야 한다.",
          "additionalProperties": false,
          "required": ["rule", "sample_count", "base_score", "log_delta", "gate", "applied", "final_score"],
          "properties": {
            "rule": { "type": "string", "description": "적용한 규칙 버전(예: v0.6.0)." },
            "sample_count": { "type": ["integer", "null"], "minimum": 0, "description": "누적 표본 수(리뷰 수 또는 GitHub stars)." },
            "sample_source": { "type": ["string", "null"], "enum": ["reviews", "github_stars", null], "description": "표본 수의 출처." },
            "base_score": { "type": ["number", "null"], "minimum": 0, "maximum": 100, "description": "보정 전 사용자 점수." },
            "log_delta": { "type": "number", "description": "누적 표본 수의 로그 보정치(게이트 적용 전)." },
            "gate": { "type": "number", "minimum": 0, "maximum": 1, "description": "평점 게이트 배율(0~1)." },
            "applied": { "type": "number", "description": "실제 적용된 보정치(클램프 반영)." },
            "final_score": { "type": ["number", "null"], "minimum": 0, "maximum": 100, "description": "보정 후 사용자 점수 = axes.user_rating.score." },
            "applied_flag": { "type": "boolean", "description": "보정이 점수를 실제로 움직였는가." }
          }
        }
      }
    },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_rating", "objective", "ai_review"],
      "properties": {
        "user_rating": {
          "$ref": "#/$defs/axis",
          "description": "축1 사용자(대중) 평가. 앱·게임·AI 도구는 최근 구간 우선·누적 보정(v0.6.0 scale_adjustment)으로 채운다. 미디어(v0.8.0)는 외부 평점 서비스를 쓰지 않으므로 score=null(⚪)로 비우고, 판정은 객관 축·작품성 축으로 계산한다."
        },
        "objective": {
          "$ref": "#/$defs/axis",
          "description": "축2 객관·신뢰 지표. v0.5.0은 기능 완성도·생태계/연동성·안정성·보안·정책/과금 투명성으로 평가하며, 클라우드·비공개 소스라는 이유만으로 깎지 않는다. 로컬·계정·데이터 수집 여부는 flags 사실과 필터·프리셋으로 가른다."
        },
        "ai_review": {
          "$ref": "#/$defs/axis",
          "description": "축3 AI 자동 검토(본질·완성도·정직성). 미디어(v0.8.0)에서는 파로스 작품성 기록 — 기저 62 + 수상(P166)·수상 후보(P1411)·교차 검증 폭(위키백과 언어판 문서 수). 완결성·접근성은 객관 축에만 둔다(중복 감점 금지)."
        },
        "personal_fit": {
          "$ref": "#/$defs/axis",
          "description": "축4 나만의 기준 적합도. 프로필이 있을 때만 계산에 포함(기본 가중치 0)."
        }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall", "tier_of_record", "signals", "one_liner", "reasons", "hard_filter_blocked"],
      "properties": {
        "overall": { "$ref": "#/$defs/verdictValue" },
        "tier_of_record": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "description": "앱 전체를 대표하는 티어의 tier_id."
        },
        "signals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["user_rating", "objective", "ai_review"],
          "properties": {
            "user_rating": { "$ref": "#/$defs/signal" },
            "objective": { "$ref": "#/$defs/signal" },
            "ai_review": { "$ref": "#/$defs/signal" },
            "personal_fit": { "$ref": "#/$defs/signal" }
          }
        },
        "one_liner": { "type": "string" },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "hard_filter_blocked": {
          "type": "boolean",
          "description": "대표 티어가 기본 활성 필터 세트에 걸렸는지."
        },
        "condition_notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "reviewMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "value", "scale", "count", "evidence_grade"],
      "properties": {
        "metric": {
          "type": "string",
          "enum": ["positive_rate", "stars", "score"]
        },
        "value": { "type": "number", "minimum": 0 },
        "scale": { "type": "string", "enum": ["percent", "stars5", "out_of_10", "out_of_100"] },
        "count": { "type": ["integer", "null"], "minimum": 0 },
        "window": { "type": "string", "description": "집계 기간(예: 최근 30일, 2026-06-08~2026-11-01)." },
        "evidence_grade": { "$ref": "#/$defs/grade" }
      }
    },
    "reviewSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_sample", "platforms", "sample_sufficient", "downgrade_applied", "summary"],
      "properties": {
        "min_sample": {
          "type": "integer",
          "minimum": 1,
          "description": "최근 리뷰 최소 표본(기준표 v0.2: 100)."
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["platform", "cumulative"],
            "properties": {
              "platform": { "$ref": "#/$defs/platform" },
              "cumulative": { "$ref": "#/$defs/reviewMetric" },
              "recent": { "$ref": "#/$defs/reviewMetric" },
              "note": { "type": "string" }
            }
          }
        },
        "sample_sufficient": { "type": "boolean" },
        "downgrade_applied": { "type": "boolean" },
        "summary": { "type": "string" }
      }
    },
    "updateProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latest_update", "cadence", "entries", "maintenance_quality", "assessment"],
      "properties": {
        "latest_update": { "type": ["string", "null"], "format": "date" },
        "latest_update_platform": { "$ref": "#/$defs/platform" },
        "cadence": { "type": "string", "enum": ["active", "irregular", "dormant", "unknown"] },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "evidence_grade", "note"],
            "properties": {
              "date": { "type": ["string", "null"], "format": "date" },
              "type": {
                "type": "string",
                "enum": ["bugfix", "performance", "content", "monetization_terms", "policy_terms", "other", "unknown"]
              },
              "platform": { "$ref": "#/$defs/platform" },
              "promise_status": {
                "type": "string",
                "enum": ["not_applicable", "on_time", "delayed", "delivered_late", "unfulfilled"]
              },
              "evidence_grade": { "$ref": "#/$defs/grade" },
              "source_ids": { "$ref": "#/$defs/sourceIdList" },
              "note": { "type": "string" }
            }
          }
        },
        "maintenance_quality": {
          "type": "string",
          "enum": ["healthy", "risky_terms", "stalled_but_trusted", "abandoned", "unknown"],
          "description": "healthy / risky_terms(과금·약관 변경이 평가 급락과 겹침) / stalled_but_trusted(과금 압박 없는 지연) / abandoned / unknown."
        },
        "assessment": { "type": "string" }
      }
    },
    "monetization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ads", "iap", "summary"],
      "properties": {
        "ads": {
          "type": "object",
          "additionalProperties": false,
          "required": ["in_app_exposure", "ad_types", "store_declares_ads", "inflow_ad"],
          "properties": {
            "in_app_exposure": {
              "type": "string",
              "enum": ["none", "low", "medium", "high", "unknown"]
            },
            "ad_types": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["none", "rewarded", "interstitial", "banner", "native", "forced_interstitial", "unknown"]
              }
            },
            "store_declares_ads": {
              "type": ["boolean", "null"],
              "description": "스토어 'Contains ads' 표기 여부. null=미확인."
            },
            "inflow_ad": {
              "type": "object",
              "additionalProperties": false,
              "required": ["present", "honesty", "evidence_grade", "note"],
              "properties": {
                "present": { "$ref": "#/$defs/tri" },
                "honesty": {
                  "type": "string",
                  "enum": ["honest", "partly_misleading", "misleading", "unknown", "not_assessed"]
                },
                "evidence_grade": { "$ref": "#/$defs/grade" },
                "source_ids": { "$ref": "#/$defs/sourceIdList" },
                "note": { "type": "string" }
              }
            }
          }
        },
        "iap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["present", "random_items", "first_purchase_prompt", "p2w", "required_to_progress", "evidence_grade"],
          "properties": {
            "present": { "$ref": "#/$defs/tri" },
            "random_items": { "$ref": "#/$defs/tri" },
            "price_range": {
              "type": "object",
              "additionalProperties": false,
              "required": ["min", "max", "evidence_grade", "note"],
              "properties": {
                "min": { "anyOf": [{ "$ref": "#/$defs/money" }, { "type": "null" }] },
                "max": { "anyOf": [{ "$ref": "#/$defs/money" }, { "type": "null" }] },
                "evidence_grade": { "$ref": "#/$defs/grade" },
                "note": { "type": "string" }
              }
            },
            "first_purchase_prompt": {
              "type": "string",
              "enum": ["immediate", "early", "mid", "late", "none", "unknown"]
            },
            "p2w": { "$ref": "#/$defs/tri" },
            "required_to_progress": { "$ref": "#/$defs/tri" },
            "evidence_grade": { "$ref": "#/$defs/grade" },
            "source_ids": { "$ref": "#/$defs/sourceIdList" }
          }
        },
        "subscription": {
          "type": "object",
          "additionalProperties": false,
          "required": ["present", "display"],
          "properties": {
            "present": { "$ref": "#/$defs/tri" },
            "display": { "type": "string" }
          }
        },
        "free_play": {
          "type": "object",
          "additionalProperties": false,
          "description": "무과금으로 본편·핵심 콘텐츠를 어디까지 즐길 수 있는가(v0.4). 확률형·P2W 의 impact 판정 근거다. impact 'optional' 이면 'sufficient' 여야 하고, impact 'core' 면 'constrained'·'blocked' 중 하나여야 한다(validate.py 검사).",
          "required": ["value", "evidence_grade", "note"],
          "properties": {
            "value": {
              "type": "string",
              "enum": ["sufficient", "constrained", "blocked", "unknown"],
              "description": "sufficient=무과금으로 본편·핵심 콘텐츠를 충분히 즐길 수 있음, constrained=즐길 수는 있으나 성장·수집·경쟁이 과금 쪽으로 기울어 제한적, blocked=과금·뽑기 없이는 진행이 막힘, unknown=미확인."
            },
            "evidence_grade": { "$ref": "#/$defs/grade" },
            "source_ids": { "$ref": "#/$defs/sourceIdList" },
            "note": { "type": "string" }
          }
        },
        "summary": { "type": "string" }
      }
    },
    "encyclopediaFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": { "type": "string", "minLength": 1, "maxLength": 40, "description": "제원 이름(플레이타임·한국어 지원·지원 OS·분량 등). 도메인 규칙은 x-pharos.client.encyclopedia.key_facts 를 따른다." },
        "value": { "type": "string", "minLength": 1, "maxLength": 200, "description": "사람이 읽는 값. 수치·표기는 확인한 출처와 같은 단위로 적는다." },
        "note": { "type": "string", "maxLength": 200, "description": "값의 근거·조건 한 줄(선택)." }
      }
    },
    "encyclopediaRelated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "relation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "파로스 카탈로그에 실제 존재하는 항목 id 만 참조한다(validate.py 가 무결성 검사)." },
        "relation": {
          "type": "string",
          "enum": ["sequel", "prequel", "adaptation", "series", "alternative"],
          "description": "sequel=이 작품의 후속작, prequel=전편, adaptation=원작·매체화 관계(애니↔만화, 영화↔원작), series=같은 시리즈·세계관의 다른 작품, alternative=같은 자리의 대안."
        },
        "note": { "type": "string", "maxLength": 200, "description": "관계를 한 줄로 설명(선택)." }
      }
    },
    "encyclopediaLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 60 },
        "url": { "type": "string", "format": "uri" },
        "note": { "type": "string", "maxLength": 160 }
      }
    },
    "encyclopedia": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "key_facts", "highlights"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 20,
          "description": "여러 줄 개요 — 작품이 무엇인지, 누가 만들었고 어떤 경험이며 어디까지 나왔는지. 마케팅 문구가 아니라 확인한 사실로 쓴다(줄바꿈 \n 허용)."
        },
        "key_facts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/encyclopediaFact" },
          "description": "도메인별 핵심 제원 — 게임=플랫폼·한국어·플레이 방식·모드·가격, 앱=지원 OS·한국어·오프라인·오픈소스·가격 모델, AI=모델·제공 방식·로컬 실행·라이선스, 미디어=제작사·감독·분량·방영/출간·원작. 확인하지 못한 값은 넣지 않는다."
        },
        "highlights": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 4, "maxLength": 200 },
          "description": "핵심 특징·볼거리·장점 3~4줄. 평가 문구(추천/거름)가 아니라 작품 자체를 설명한다."
        },
        "related": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/encyclopediaRelated" },
          "description": "파로스 안의 관련작 연결 — 클릭하면 그 작품 상세로 이동한다. 반드시 실제 존재하는 id 만."
        },
        "official_links": {
          "type": "array",
          "maxItems": 6,
          "items": { "$ref": "#/$defs/encyclopediaLink" },
          "description": "공식 홈페이지·위키·공식 채널 등 추가 참고 링크(선택). 스토어 출처는 sources 가 이미 갖고 있다."
        }
      }
    },
    "dataQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall_grade", "unverified", "conflicts", "limitations"],
      "properties": {
        "overall_grade": { "$ref": "#/$defs/grade" },
        "unverified": {
          "type": "array",
          "items": { "type": "string" },
          "description": "확인하지 못한 수치·주장. 추정으로 채우지 않고 여기에 남긴다."
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "values", "resolution"],
            "properties": {
              "field": { "type": "string" },
              "values": { "type": "array", "items": { "type": "string" } },
              "resolution": { "type": "string" },
              "source_ids": { "$ref": "#/$defs/sourceIdList" }
            }
          }
        },
        "limitations": { "type": "string" }
      }
    }
  },
  "x-pharos": {
    "schema_version": "0.4.0",
    "criteria_version": "v0.8.0",
    "criteria_doc": "projects/pharos/criteria.md",
    "client": {
      "note": "정적 웹 프론트엔드가 서버 없이 계산하는 계약. 아이템 1건 × 티어 1개 단위로 적용한다.",
      "media_independence": {
        "version": "v0.8.0",
        "domains": ["movie", "anime", "manga"],
        "user_axis": "empty",
        "note": "미디어는 외부 평점 서비스(점수·인기도·URL)를 쓰지 않는다. 사용자 축은 비우고(score=null), 판정은 객관 축(완결성·접근 경로·작품 수명)과 작품성 축(수상·수상 후보·교차 검증 폭)으로 한다.",
        "fact_source": {
          "id": "wikidata",
          "label": "Wikidata",
          "license": "CC0",
          "url": "https://www.wikidata.org",
          "grade": "B",
          "unmatched": {"id": "pharos-record", "label": "파로스 자체 기록", "grade": "C"}
        },
        "merit_axis": {
          "axis": "ai_review",
